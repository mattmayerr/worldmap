# Required for AI chat. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: change the model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Auth — required for user logins and session cookies (min 16 characters)
AUTH_SECRET=change-me-to-a-long-random-string

# Bootstrap the first admin account (created automatically on first login if no admin exists)
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=your-secure-password
